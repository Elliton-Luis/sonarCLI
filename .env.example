# ============================================================================
# SONAR: TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ============================================================================
# Copie este arquivo para .env e preencha com suas próprias credenciais:
# cp .env.example .env
# ============================================================================

# Token do Bot fornecido pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Seu Chat ID numérico pessoal no Telegram
ALLOWED_CHAT_ID=123456789

# Chaves de API para STT e Orquestração
GROQ_API_KEY=gsk_your_groq_key_here
NVIDIA_API_KEY=nvapi_your_nvidia_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# PIN de 4 a 6 dígitos para proteção 2FA do bot (Opcional, deixe vazio para desativar)
SESSION_PIN=1234
SESSION_TIMEOUT_MINUTES=60

# Orquestração de Dificuldade
ENABLE_ORCHESTRATOR=true
ORCHESTRATOR_MODEL=deepseek/deepseek-v4.1-flash

# Agente padrão e forte para tarefas de projeto
DEFAULT_AGENT=agy
STRONG_AGENT=agy
STRONG_MODEL=

# Workspace inicial e Jail Base
DEFAULT_WORKSPACE_DIR=/home/user/projects/sonar
PROJECTS_BASE_DIR=/home/user/projects
